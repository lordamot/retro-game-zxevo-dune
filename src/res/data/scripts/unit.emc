; unit.emc - UNIT.EMC, the 2676 words of its
; DATA chunk (27 entry points), from orig/dune2.gen $04E180.
;
; Written once by tools/sega/port_data.py; this text is now the source.
; tools/dune_data.py assembles it back to the cartridge's bytecode
; exactly (port_data.py check proves it) and writes scripts.inc.
; S7 is the reference for the machine and for every routine.
;
; .functions N         the size of the script's call table
; .func I NAME         call index I, the 68000 routine it reaches
; .entry I LABEL       ORDR entry I (a unit, a building, a behaviour)
; LABEL:               a word offset; wNNN labels keep the offsets of
;                      orig/sega/res/data/scripts/*.txt
;
; One instruction a line; the encoding is fixed per instruction:
;   goto L        $8000 | L                  (1 word)
;   goto-if L     $2F00, $8000 | L: pops, jumps if it was zero (2 words)
;   push.w n      $2300, n                   (2 words)
;   everything else $4000 | op << 8 | byte   (1 word):
;   setret push.ret push.pc push.b push.var push.loc push.arg
;   pop.ret ret pop.var pop.loc pop.arg drop reserve call unary
;   binary return;   .word $XXXX is a raw word.

.script unit
.functions 64
.func 0   get           ; $04500C twenty properties of the unit and its type - see PROPERTY below
.func 1   act           ; $044F2E give the unit action n, through $0436A0
.func 2   print         ; $011014 print string n of the script's own text with three more arguments, into $FFC5B0; never called
.func 3   distance      ; $01110C how far the reference is from me, or -1
.func 4   explode       ; $045808 the death animation and the sound that goes with it
.func 5   go.to         ; $044D7E set where the unit is headed ($5C); a Harvester gets a spice field rather than a thing
.func 6   dir.to        ; $044D2E which way the reference is, or my own facing if it is stale
.func 7   turn          ; $044C44 turn towards n and answer the facing reached
.func 8   fire          ; $0447E2 shoot at $5A, if the gun is lined up on it
.func 9   deploy        ; $045E2C an MCV becomes a Construction Yard: $00E580 makes structure 8 on my square or one of the three up and left of it ($0FEE20), and the unit is removed; 0 if none fits
.func 10  act.default   ; $044F78 give the unit the action its type names at +$28
.func 11  zero11        ; $045F82 returns 0 and nothing else
.func 12  step          ; $0452C2 one step of the way towards $5C
.func 13  enemy?        ; $0113AC the reference belongs to another house
.func 14  blast.stub    ; $0446C4 returns 0 and nothing else - called with 4, 6 or 9 as a unit dies
.func 15  die           ; $0445EE the unit is destroyed: the score moves, a Saboteur takes 500 points of everything with it
.func 16  delay         ; $01108A wait n/5 ticks - writes the countdown the tick loop at $043BCC decrements
.func 17  friend?       ; $011358 the reference is an active thing of my own house
.func 18  explode.big   ; $0446C8 the blast of Destruct and of a dying Devastator: explosion 11 where I stand and seven of type 6 round it ($00A934); the argument is not read
.func 19  frame         ; $0443F8 show frame n of the unit's own animation: $73 = -n, and ask for a redraw
.func 20  deliver       ; $043D80 put down the unit I am carrying at $5C - into a structure (a Starport takes the whole load) or on the ground where I am
.func 21  zero21        ; $043CEC returns 0 and nothing else
.func 22  fly.to        ; $04442A fly straight at $5C (a Refinery's or a Starport's pad), sliding the last $80; answers 1 on arrival and until then waits and runs the call again
.func 23  random        ; $0110D8 a random number between the two arguments
.func 24  fn24          ; $01143E a structure of my house that is idle: the one the reference names, or the first of type n; never called
.func 25  head.for      ; $044F92 point the hull at the reference, keeping it in $4E as where I am going
.func 26  stop          ; $044358 speed 0, and ask for a redraw
.func 27  speed         ; $044380 set the speed, clamped to 0-255 and cut to three quarters if $4 bit 9 is set
.func 28  find.target   ; $043D60 the best thing for me to attack, as a reference: the best unit ($04730C) and structure ($01072C) weighed against each other; n=4 takes a structure first, and a Deviator never looks at structures
.func 29  fn29          ; $043CF0 how much I want to attack the reference - $047166 for a unit, $010688 for a structure; never called
.func 30  seek.dock     ; $0456B8 an idle structure of type n to go to - the one the unit I carry came from ($52) if it is free, else the first of my house - claimed and put in $5C, as a reference
.func 31  fn31          ; $0457EE bit 8 of the unit's flags; never called
.func 32  amount        ; $0457C2 the spice ($5E) in the unit I am carrying, or in me if I carry nothing
.func 33  survivor      ; $04587C with the chance at +$E of my type (64 in 256, a Harvester 128) a Soldier of my house is made near me and given order n
.func 34  pick.up       ; $043FE0 take on board the unit $5C names, or the one waiting in the structure it names, and choose where to carry it
.func 35  call.unit     ; $045912 a free unit of type n of my house is claimed and sent for me ($5C = me) - the one I have already, or 0 if my type cannot be carried
.func 36  dismiss       ; $0459D8 if what I have claimed is a Carryall, clear its $5C and let it go
.func 37  find.struct   ; $045A16 a structure of my house and of type n that is idle, empty and unclaimed, as a reference
.func 38  zero38        ; $0112EE returns 0 and nothing else
.func 39  rts.stub      ; $045A88 a bare rts
.func 40  unfog         ; $045A8A clear the fog round me, as far as +$12 of my type says ($019FFE) - only the player's own
.func 41  find.spice    ; $0112F2 the nearest square of spice (ground type 8 or 9) within $20 of me, from $01A146, as a place - or 0, and remember there was none; the argument is not read
.func 42  harvest       ; $045A9C a Harvester on spice with room ($5E < 100) takes a little more; answers 1 while it should keep at it, and now and then the square loses its spice ($01A518)
.func 43  zero43        ; $043CEC returns 0 and nothing else
.func 44  linked.type   ; $0112C4 the type of the unit I am carrying ($3), or -1
.func 45  kind          ; $011292 the reference's kind: 1 unit, 2 structure, 3 a place; -1 if it is stale
.func 46  fn46          ; $011260 the reference's value - a packed square for a place, the index otherwise ($02E3B2), or -1; never called
.func 47  blocked?      ; $045B6A 1 when what I carry cannot be set down at the reference ($046F68 refuses the square, or the structure is not ours or will not take it), 0 when it can - once read the other way round, as 'clear?'
.func 48  nearby        ; $045C48 a random square close to me ($011688, $50), as a place - only if the argument is a place, else 0
.func 49  fidget        ; $045CD8 a foot unit shuffles on the spot
.func 50  count         ; $011212 how many units of type n my house has (the unit pool, through $04321C)
.func 51  go.nearest    ; $045D6E order Move to the nearest idle, empty, unclaimed structure of my house of type n; 1 if there is one
.func 52  zero52        ; $043CEC returns 0 and nothing else
.func 53  zero53        ; $043CEC returns 0 and nothing else
.func 54  find.prey     ; $045EC6 the unit the Sandworm most wants: every unit scored by $04754E, the best as a reference
.func 55  claim.ok?     ; $045EF2 1 if what I have claimed still claims me and is of my house; otherwise break the claim, clear a unit's $5C, and answer 0
.func 56  facing.of     ; $0111E6 the hull facing ($6A) of the unit the reference names, or $80 if it names no unit
.func 57  zero57        ; $043CEC returns 0 and nothing else
.func 58  aim           ; $044E04 set what the unit is shooting at ($5A), and turn the hull too if it has no turret
.func 59  not.unit?     ; $01118A 1 unless the reference names a unit - a structure, a place or nothing all answer 1
.func 60  delay.rnd     ; $0110A6 the same, but a random fraction of n
.func 61  turning?      ; $044C78 turn the gun towards $5A; answer whether it still has further to go
.func 62  distance.to   ; $011152 the same, but to the near edge of a structure rather than its middle ($02E0A8), or -1
.func 63  zero63        ; $043CEC returns 0 and nothing else

