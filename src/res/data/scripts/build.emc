; build.emc - BUILD.EMC, the 502 words of its
; DATA chunk (19 entry points), from orig/dune2.gen $04DB28.
;
; Written once by tools/sega/port_data.py; this text is now the source.
; tools/dune_data.py assembles it back to the cartridge's bytecode
; exactly (port_data.py check proves it) and writes scripts.inc.
; S7 is the reference for the machine and for every routine.
;
; .functions N         the size of the script's call table
; .func I NAME         call index I, the 68000 routine it reaches
; .entry I LABEL       ORDR entry I (a unit, a building, a behaviour)
; LABEL:               a word offset; wNNN labels keep the offsets of
;                      orig/sega/res/data/scripts/*.txt
;
; One instruction a line; the encoding is fixed per instruction:
;   goto L        $8000 | L                  (1 word)
;   goto-if L     $2F00, $8000 | L: pops, jumps if it was zero (2 words)
;   push.w n      $2300, n                   (2 words)
;   everything else $4000 | op << 8 | byte   (1 word):
;   setret push.ret push.pc push.b push.var push.loc push.arg
;   pop.ret ret pop.var pop.loc pop.arg drop reserve call unary
;   binary return;   .word $XXXX is a raw word.

.script build
.functions 25
.func 0   delay         ; $01108A wait n/5 ticks - writes the countdown the tick loop at $043BCC decrements
.func 1   zero1         ; $00C64E returns 0 and nothing else
.func 2   check.link    ; $00C65E make sure the docked unit still points back here, and break the link if it does not
.func 3   send.for      ; $00C6C0 when a unit is ready ($5C = 2), claim a free unit of type n through $04875A - the Carryall - to come and take it; it does not put the unit on the map itself (the PC game's FindUnitByType).  Once read as 'produce'
.func 4   set.state     ; $00C7CC set the structure's state ($5C, through $00FA0E); $FFFE means work it out from whether anything is docked
.func 5   print         ; $011014 print string n of the script's own text with three more arguments, into $FFC5B0; never called
.func 6   unclaim       ; $00CD6E if the reference is a unit, break its claim and clear its $5C
.func 7   release       ; $00C818 send the docked unit back out
.func 8   find.target   ; $00CA0C the unit a turret should shoot, within n (three times n for a flyer): its current $26 if still in reach, else the nearest one my house has seen, as a reference
.func 9   aim           ; $00CB92 turn the turret towards the reference
.func 10  fn10          ; $00CD06 which way the reference is, in eighths, or $4E; never called
.func 11  fire          ; $00CDD0 shoot at $26
.func 12  zero12        ; $00C64E returns 0 and nothing else
.func 13  state         ; $00C652 the structure's state ($5C)
.func 14  fn14          ; $00CFE2 sound n ($00A7D8), if the building is the player's; never called
.func 15  unfog         ; $00D012 clear the fog round the building, as far as +$12 of its type says - only the player's own
.func 16  zero16        ; $00C64E returns 0 and nothing else
.func 17  zero17        ; $00C64E returns 0 and nothing else
.func 18  zero18        ; $00C64E returns 0 and nothing else
.func 19  zero19        ; $00C64E returns 0 and nothing else
.func 20  zero20        ; $00C64E returns 0 and nothing else
.func 21  refine        ; $00D068 take a load of spice out of the docked Harvester ($5E) and pay 7 credits a unit, up to the house's storage; state 2 when it is empty
.func 22  explode       ; $00D1EA explosions over every square of the building, and a Starport's cargo is lost
.func 23  destroy       ; $00D4C8 the building goes ($00F71A), and each square may leave a Soldier behind, by the chance at +$E of its type
.func 24  zero24        ; $00C64E returns 0 and nothing else

.entry 0   build_slab
.entry 1   build_slab4
.entry 2   build_palace
.entry 3   build_lightfactory
.entry 4   build_heavyfactory
.entry 5   build_hitech
